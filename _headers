/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=15552000
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# ------------------------------------------------------------------
# SPRACHSPERRE
# Die noch nicht vollstaendigen Sprachbereiche sind online abrufbar,
# sollen aber noch NICHT bei Google auftauchen. Zusaetzlich zum
# noindex-Meta in jeder Seite steht hier der Riegel auf Server-Ebene.
#
# ZUM FREISCHALTEN einer Sprache: den passenden Block hier loeschen
# UND das Kuerzel in sprachmatrix.py aus GESPERRT entfernen, dann das
# Skript laufen lassen (setzt Meta-Tags und Sitemap nach).
#
# robots.txt bleibt bewusst auf "Allow: /" — waere dort ein Disallow,
# koennte Google die Seiten gar nicht erst lesen und damit auch das
# noindex nicht sehen. Das ist der klassische Fehler an dieser Stelle.
# ------------------------------------------------------------------

/it/*
  X-Robots-Tag: noindex, follow

/nl/*
  X-Robots-Tag: noindex, follow

/ja/*
  X-Robots-Tag: noindex, follow
