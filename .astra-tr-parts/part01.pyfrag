from pathlib import Path

ROOT = Path('.')
changes = []

def rep(path, old, new, expected=1, label=''):
    p = ROOT / path
    text = p.read_text(encoding='utf-8')
    n = text.count(old)
    if n != expected:
        print(f'SKIP {path}: {label or old[:80]!r}: expected {expected}, found {n}')
        return
    p.write_text(text.replace(old, new), encoding='utf-8')
    changes.append((path, label or old[:80], n))

def remove(path, old, expected=1, label=''):
    rep(path, old, '', expected, label)

